# The match data is NOT redistributable (see the competition's terms).
# The submission repo is public: none of this may get in.
# Anchored to the root (where MTAH_DATA_DIR points by default): analysis/handoff-plugin-data/data/
# holds result tables that must be committed.
/data/
*.mp4
*_atd.txt
*_homography.csv
*_smart_tagging.xml

# Outputs
out/
*.csv
!vendor/evaluation/gt/*.csv
# The results tables of the analysis material do get in (they are model outputs and
# aggregates over public matches, never match data).
!analysis/**/*.csv
evaluation/results/
reports/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# Environment
.DS_Store
.env

# Official reference baselines (vendored, not match data)
!vendor/evaluation/results/*.csv.gz
